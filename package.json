{
  "name": "graveshift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "bun lint --no-script --max-warnings=0 --allow-unsupported",
    "typecheck": "bun check --no-script",
    "test:check": "bun test --check",
    "test": "bun test",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test:check && bun run test"
  },
  "devDependencies": {
    "@graveshift/policy": "workspace:*",
    "@types/bun": "1.4.4",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
