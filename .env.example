OPENAI_COMPATIBLE_API_KEY=
# Agent model keys. Names only; put values in your local environment or secret store.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Same-host processes. Two distinct internal credentials, one per hop. Values must differ.
# The daemon and actuator present the API token; the API presents the daemon token.
HOST=127.0.0.1
PORT=3000
GRAVESHIFT_PROJECT_ID=local
GRAVESHIFT_API_INTERNAL_TOKEN=
GRAVESHIFT_DAEMON_INTERNAL_TOKEN=
GRAVESHIFT_API_URL=http://127.0.0.1:3000
GRAVESHIFT_DAEMON_URL=http://127.0.0.1:2602
# Set only for an unpublished container network on the same machine.
GRAVESHIFT_PRIVATE_HOST=
# Defaults deny model spending. Set explicit rates and limits for your selected models.
GRAVESHIFT_GATEWAY_CONFIG={"globalDailyBudgetUsd":0,"maxRetries":1,"timeoutMs":30000,"priceTableUsdPer1M":{}}

# GitHub App identity for the fix path. The private key is a local secret.
GRAVESHIFT_GITHUB_PRIVATE_KEY=

# API credentials and event ingest. Fill these before boot.
GRAVESHIFT_OAUTH_JWT_SECRET=
GRAVESHIFT_OAUTH_ISSUER=graveshift-api
GRAVESHIFT_OAUTH_AUDIENCE=graveshift-credentials
GRAVESHIFT_OAUTH_CLIENTS=
GRAVESHIFT_CREDENTIAL_TTL_SECONDS=86400
GRAVESHIFT_CREDENTIAL_MAX_TTL_SECONDS=2592000
GRAVESHIFT_EVENT_MAX_BYTES=65536
GRAVESHIFT_EVENT_RATE_LIMIT=60
GRAVESHIFT_EVENT_RATE_TTL_MS=60000
GRAVESHIFT_NATS_URL=nats://127.0.0.1:4222
GRAVESHIFT_NATS_STREAM=GRAVESHIFT_EVENTS
# Daemon read settings introduced by ticket #48 and enforced there.
# Add no secret value here.
GRAVESHIFT_DAEMON_READ_TOKEN=
GRAVESHIFT_DAEMON_READ_URL=
# Local placeholder only. Override with your own value for a real database.
DATABASE_URL=postgresql://graveshift:graveshift@localhost:5436/graveshift

# Exorcism publication. Keep these values in the daemon environment only.
GRAVESHIFT_GITHUB_APP_ID=
GRAVESHIFT_GITHUB_PRIVATE_KEY_PEM=
GRAVESHIFT_GITHUB_INSTALLATIONS={}
GRAVESHIFT_VERIFY_COMMANDS={}
GRAVESHIFT_VERIFY_TIMEOUT_MS=30000
GRAVESHIFT_DASHBOARD_URL=

# Optional read-only Collectors. Each value enables that Collector.
GRAVESHIFT_DOCKER_URL=
GRAVESHIFT_K8S_ENABLED=false
GRAVESHIFT_K8S_NAMESPACES=[]
GRAVESHIFT_PROMETHEUS_URL=
GRAVESHIFT_METRIC_TARGETS=[]
GRAVESHIFT_COLLECTOR_SERVICE=host

# Separate privileged actuator. A fix never invokes it.
ACTUATOR_HMAC_SECRET=
DOCKER_PROXY_URL=
TARGET_NAMESPACE=
