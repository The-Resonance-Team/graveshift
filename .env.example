OPENAI_COMPATIBLE_API_KEY=

# API credentials and event ingest. Fill these before boot.
GRAVESHIFT_OAUTH_JWT_SECRET=
GRAVESHIFT_OAUTH_ISSUER=graveshift-api
GRAVESHIFT_OAUTH_AUDIENCE=graveshift-credentials
GRAVESHIFT_OAUTH_CLIENTS=
GRAVESHIFT_CREDENTIALS_PATH=.graveshift/credentials.json
GRAVESHIFT_CREDENTIAL_TTL_SECONDS=86400
GRAVESHIFT_CREDENTIAL_MAX_TTL_SECONDS=2592000
GRAVESHIFT_EVENT_MAX_BYTES=65536
GRAVESHIFT_EVENT_RATE_LIMIT=60
GRAVESHIFT_EVENT_RATE_TTL_MS=60000
GRAVESHIFT_NATS_URL=
