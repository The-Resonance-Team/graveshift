    "@graveshift/fixer": "workspace:*",
    "@graveshift/patch": "workspace:*",
    "@graveshift/policy": "workspace:*",
    "@graveshift/redactor": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "12.6.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.0",
    "@nestjs/http-client": "0.0.3",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/mcp": "0.0.4",
    "@nestjs/passport": "12.0.2",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/throttler": "6.8.0",
    "@prisma/adapter-pg": "7.10.1",
