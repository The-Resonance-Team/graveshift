{
  "name": "@graveshift/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "start:stdio": "bun src/stdio.ts",
    "test": "bun test",
    "typecheck": "bun check --no-script",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:drift:check": "bun scripts/check-prisma-drift.ts",
