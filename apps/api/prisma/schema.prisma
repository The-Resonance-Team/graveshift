// The API owns the durable store. Public Audit fields stay in packages/core.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkItemStatus {
  todo
  in_progress
  in_review
  done
}

enum WorkItemPriority {
  low
  medium
  high
  critical
}

enum WorkItemSeverity {
  info
  warning
  critical
}

enum CredentialKind {
  mcp
  plugin
}

enum FixAttemptTrigger {
  auto_fix
  fix_now
}

enum FixAttemptState {
  claimed
  awaiting_answer
  running
  publishing
  completed
  failed
  needs_human
  uncertain
}

enum MembershipRole {
  owner
  member
}

model Account {
  id                 String       @id @default(uuid())
  email              String       @unique
  passwordHash       String       @map("password_hash")
  mustChangePassword Boolean      @default(false) @map("must_change_password")
  createdAt          DateTime     @default(now()) @map("created_at")
  memberships        Membership[]

  @@map("accounts")
}

model Organization {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  createdAt    DateTime      @default(now()) @map("created_at")
  memberships  Membership[]
  projects     Project[]
  oauthClients OAuthClient[]
  releases     Release[]
  environments Environment[]
  deploys      Deploy[]

  @@map("organizations")
}

model Membership {
  accountId    String         @map("account_id")
  orgId        String         @map("org_id")
  role         MembershipRole
  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([accountId, orgId])
  @@index([orgId])
  @@map("memberships")
}

model Project {
  projectId    String           @id @map("project_id")
  orgId        String           @map("org_id")
  name         String
  slug         String
  createdAt    DateTime         @default(now()) @map("created_at")
  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  oauthClients OAuthClient[]
  releaseLinks ProjectRelease[]
  deployLinks  DeployProject[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("projects")
}

model Release {
  id           String           @id @default(uuid())
  orgId        String           @map("org_id")
  version      String
  createdAt    DateTime         @default(now()) @map("created_at")
  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectLinks ProjectRelease[]
  deploys      Deploy[]

  @@unique([orgId, version])
  @@index([orgId])
  @@map("releases")
}

model ProjectRelease {
  projectId String  @map("project_id")
  releaseId String  @map("release_id")
  project   Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@id([projectId, releaseId])
  @@index([releaseId])
  @@map("project_releases")
}

model Environment {
  id           String       @id @default(uuid())
  orgId        String       @map("org_id")
  name         String
  createdAt    DateTime     @default(now()) @map("created_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deploys      Deploy[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("environments")
}

model Deploy {
  id            String          @id @default(uuid())
  orgId         String          @map("org_id")
  releaseId     String          @map("release_id")
  environmentId String          @map("environment_id")
  name          String
  dateStarted   DateTime        @map("date_started")
  dateFinished  DateTime?       @map("date_finished")
  url           String?
  createdAt     DateTime        @default(now()) @map("created_at")
  organization  Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  release       Release         @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  environment   Environment     @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  projectLinks  DeployProject[]

  @@index([orgId, releaseId])
  @@index([environmentId])
  @@map("deploys")
}

model DeployProject {
  deployId  String  @map("deploy_id")
  projectId String  @map("project_id")
  deploy    Deploy  @relation(fields: [deployId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@id([deployId, projectId])
  @@index([projectId])
  @@map("deploy_projects")
}

model OAuthClient {
  clientId     String       @id @map("client_id")
  secretHash   String       @map("secret_hash")
  orgId        String       @map("org_id")
  projectId    String       @map("project_id")
  scopes       String[]
  createdAt    DateTime     @default(now()) @map("created_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([orgId])
  @@map("oauth_clients")
}

model DaemonGrant {
  id         String   @id @default(uuid())
  name       String   @unique
  projectIds String[] @map("project_ids")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("daemon_grants")
}

model WorkItem {
  id              String           @id
  projectId       String           @map("project_id")
  title           String
  description     String
  successCriteria String[]         @map("success_criteria")
  subtasks        Json
  status          WorkItemStatus
  priority        WorkItemPriority
  assignee        String
  reporter        String
  startDate       DateTime?        @map("start_date") @db.Date
  dueDate         DateTime?        @map("due_date") @db.Date
  sprint          String?
  parent          String?
  labels          String[]
  team            String
  watchers        String[]
  severity        WorkItemSeverity
  service         String
  diagnosisRef    String           @map("diagnosis_ref")
  diagnosis       Json?
  fixPriority     Int              @map("fix_priority")
  draftPr         Json?            @map("draft_pr")
  activeAttemptId String?          @map("active_attempt_id")
  version         Int              @default(0)
  attempts        FixAttempt[]
  commands        WorkCommand[]

  @@unique([projectId, id])
  @@index([projectId])
  @@map("work_items")
}

model FixAttempt {
  id              String            @id
  projectId       String            @map("project_id")
  commandId       String            @map("command_id")
  workItemId      String            @map("work_item_id")
  agent           String
  workerId        String?           @map("worker_id")
  leaseUntil      DateTime?         @map("lease_until")
  trigger         FixAttemptTrigger
  state           FixAttemptState
  routingProgress Json?             @map("routing_progress")
  params          Json
  questionId      String?           @map("question_id")
  result          Json?
  publication     Json?
  baseSha         String?           @map("base_sha")
  version         Int               @default(0)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")
  workItem        WorkItem          @relation(fields: [projectId, workItemId], references: [projectId, id])

  @@unique([projectId, commandId])
  @@index([projectId, workItemId])
  @@map("fix_attempts")
}

model WorkCommand {
  projectId   String   @map("project_id")
  commandId   String   @map("command_id")
  workItemId  String   @map("work_item_id")
  actor       String
  kind        String
  requestHash String   @map("request_hash")
  workVersion Int?     @map("work_version")
  attemptId   String?  @map("attempt_id")
  result      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  workItem    WorkItem @relation(fields: [projectId, workItemId], references: [projectId, id])

  @@id([projectId, commandId])
  @@index([projectId, workItemId])
  @@map("work_commands")
}

model Haunting {
  projectId  String   @map("project_id")
  id         String
  service    String
  state      String
  incident   Json
  diagnosis  Json?
  detections Json
  pr         Json?
  timeline   Json
  openedAt   DateTime @map("opened_at")
  updatedAt  DateTime @map("updated_at")

  @@id([projectId, id])
  @@index([projectId, service])
  @@map("hauntings")
}

model AuditEntry {
  projectId  String   @map("project_id")
  eventKey   String?  @map("event_key")
  seq        Int
  at         DateTime
  actor      String
  type       String
  incidentId String?  @map("incident_id")
  payload    Json
  prevHash   String   @map("prev_hash")
  hash       String

  @@id([projectId, seq])
  @@unique([projectId, eventKey])
  @@map("audit_entries")
}

model ActionClaim {
  projectId   String    @map("project_id")
  tokenId     String    @map("token_id")
  actionId    String    @map("action_id")
  requestHash String    @map("request_hash")
  service     String
  incidentId  String    @map("incident_id")
  state       String
  result      Json?
  admittedAt  DateTime  @default(now()) @map("admitted_at")
  completedAt DateTime? @map("completed_at")
  expiresAt   DateTime  @map("expires_at")

  @@id([projectId, tokenId])
  @@unique([projectId, actionId])
  @@index([projectId, service, admittedAt])
  @@map("action_claims")
}

model Credential {
  id                  String         @id
  projectId           String         @map("project_id")
  kind                CredentialKind
  name                String
  prefix              String
  hash                String
  clientId            String         @map("client_id")
  scopes              String[]
  service             String?
  createdAt           DateTime       @map("created_at")
  expiresAt           DateTime?      @map("expires_at")
  revokedAt           DateTime?      @map("revoked_at")
  expirationAuditedAt DateTime?      @map("expiration_audited_at")

  @@unique([projectId, hash])
  @@index([hash])
  @@map("credentials")
}
