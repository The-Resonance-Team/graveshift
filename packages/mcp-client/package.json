{
  "name": "@graveshift/mcp-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./drift": "./src/drift.ts"
  },
  "scripts": {
    "typecheck": "bun check --no-script",
    "test": "bun test --tsconfig-override ../../apps/api/tsconfig.json",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "drift:check": "cd ../.. && bun --tsconfig-override apps/api/tsconfig.json packages/mcp-client/scripts/drift-check.ts"
  },
  "dependencies": {
    "@graveshift/core": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "reflect-metadata": "0.2.2"
  }
}
