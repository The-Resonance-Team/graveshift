{
  "openapi": "3.0.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The API is ready.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/rules/validate": {
      "post": {
        "operationId": "RulesController_validate",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "systemRules": {
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "enabled": {
                          "type": "boolean"
                        },
                        "priority": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "match": {
                          "type": "object",
                          "properties": {
                            "severities": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "info",
                                  "warning",
                                  "critical"
                                ]
                              }
                            },
                            "services": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "types": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
                              }
                            },
                            "tenantId": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9_-]+$"
                            }
                          }
                        },
                        "action": {
                          "type": "string",
                          "enum": [
                            "detect",
                            "suppress",
                            "escalate"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "enabled",
                        "priority",
                        "match",
                        "action"
                      ]
                    }
                  },
                  "clientRules": {
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "enabled": {
                          "type": "boolean"
                        },
                        "priority": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "match": {
                          "type": "object",
                          "properties": {
                            "severities": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "info",
                                  "warning",
                                  "critical"
                                ]
                              }
                            },
                            "services": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "types": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
                              }
                            },
                            "tenantId": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9_-]+$"
                            }
                          }
                        },
                        "action": {
                          "type": "string",
                          "enum": [
                            "detect",
                            "suppress",
                            "escalate"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "enabled",
                        "priority",
                        "match",
                        "action"
                      ]
                    }
                  },
                  "confirmOverrides": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "systemRules",
                  "clientRules"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The rule set is accepted. No rule is stored.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "overrideIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "warning": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "accepted",
                    "overrideIds",
                    "warning"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "409": {
            "description": "The rule overrides are not confirmed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "overrideIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "warning": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "overrideIds",
                    "warning"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "rules"
        ]
      }
    }
  },
  "info": {
    "title": "Graveshift API",
    "description": "The only external surface of Graveshift.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {}
  }
}
